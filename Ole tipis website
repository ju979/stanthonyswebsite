<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Ole Tipis Girls High School</title>

<style>
:root {
    --green: #124b36;
    --gold: #e4b84b;
    --cream: #fffaf0;
    --white: #ffffff;
}

* {
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    line-height: 1.8;
    color: #26352d;
    background: var(--cream);
}

/* Principal's photograph as a transparent background */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: url("principal.jpg");
    background-position: center;
    background-size: cover;
    opacity: 0.07;
    z-index: -1;
    pointer-events: none;
}

header {
    background: var(--green);
    color: white;
    padding: 25px 15px;
    text-align: center;
    border-bottom: 6px solid var(--gold);
}

.school-logo {
    width: 110px;
    height: 110px;
    object-fit: contain;
    background: white;
    border-radius: 50%;
    padding: 5px;
}

header h1 {
    margin-bottom: 5px;
    font-size: clamp(24px, 5vw, 38px);
}

header p {
    margin: 4px;
}

nav {
    background: #0b3527;
    padding: 12px;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 10;
}

nav a {
    color: white;
    text-decoration: none;
    display: inline-block;
    padding: 7px 10px;
    font-size: 14px;
}

nav a:hover {
    color: var(--gold);
}

main {
    width: min(1100px, 94%);
    margin: auto;
}

section {
    padding: 28px 20px;
    background: rgba(255, 255, 255, 0.94);
    margin: 22px 0;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
}

h2 {
    color: var(--green);
    border-left: 5px solid var(--gold);
    padding-left: 12px;
}

h3 {
    color: var(--green);
}

hr {
    border: none;
    height: 3px;
    background: var(--gold);
    margin: 20px 0;
}

.identity {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 15px;
}

.identity article {
    background: #f1f7f1;
    border: 1px solid #d5e4d8;
    border-radius: 10px;
    padding: 15px;
}

.principal-card {
    max-width: 680px;
    margin: auto;
    padding: 25px;
    text-align: center;
    background: #f4f0e6;
    border: 2px solid var(--gold);
    border-radius: 12px;
}

.principal-photo {
    width: min(260px, 90%);
    height: 300px;
    object-fit: cover;
    object-position: center top;
    border: 5px solid white;
    border-radius: 12px;
    box-shadow: 0 4px 15px #aaa;
}

.principal-message {
    background: white;
    border-left: 5px solid var(--green);
    padding: 20px;
    margin-top: 20px;
    text-align: left;
    font-style: italic;
}

.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 15px;
}

.gallery figure {
    margin: 0;
    background: white;
    border-radius: 9px;
    overflow: hidden;
    box-shadow: 0 2px 10px #ddd;
}

.gallery img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    display: block;
}

figcaption {
    padding: 12px;
    font-size: 14px;
    text-align: center;
}

.video-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 10px;
}

.video-container iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
}

button {
    padding: 12px 18px;
    background: var(--green);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

button:hover {
    background: #246d4e;
}

a {
    color: #17613e;
}

footer {
    background: var(--green);
    color: white;
    padding: 25px;
    text-align: center;
    border-top: 5px solid var(--gold);
}

footer a {
    color: var(--gold);
}

@media (max-width: 600px) {
    nav {
        position: static;
    }

    nav a {
        padding: 6px;
    }

    section {
        padding: 20px 14px;
    }
}
</style>
</head>

